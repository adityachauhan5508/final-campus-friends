# SMART CAMPUS ASSISTANT - FRONTEND ENVIRONMENT CONFIGURATION
# Copy this file to .env in the project root: .env

# Supabase Public Anonymous Keys (Safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Python FastAPI Backend URL (Defaults to localhost:8000 during local dev, or your deployed backend URL on Render/Railway/Fly.io)
VITE_API_BASE_URL=http://localhost:8000
