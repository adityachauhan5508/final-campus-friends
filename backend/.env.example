# SMART CAMPUS ASSISTANT - ENVIRONMENT CONFIGURATION (BACKEND)
# Copy this file to .env inside the backend directory: backend/.env

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials (From your Supabase Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Backend Server Configuration
PORT=8000
